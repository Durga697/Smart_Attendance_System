# Environment Variables for Smart Attendance System

# Flask Secret Key (Generate a random string for production)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Admin User Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Data Directory Path (For persistent disk mount, e.g., /var/data on Render)
DATA_DIR=.

# Server Port (Render sets this dynamically)
PORT=5000

# Flask Debug Mode
FLASK_DEBUG=False
